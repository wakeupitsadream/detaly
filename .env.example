# Пример окружения «Детали». Копия для работы: cp .env.example .env
# Каждая переменная здесь есть в packages/config/src/env.ts и наоборот (проверяется тестом).
# Пустое значение = «не задано», берётся значение по умолчанию из схемы.
# Метки: [ф0] фаза 0, [ф1A]/[ф1B]/[ф1C], [ф2], [ф3]; [infra] читают только compose, Caddy и backup.
# Деньги в env — в рублях (в коде и БД — копейки), проценты — числом (28 = 28%).

# --- Приложение [ф0] ---
NODE_ENV=development
LOG_LEVEL=info
# Часовой пояс дат для клиента и cron; суточная квота Rossko считается по Москве в коде.
TZ=Asia/Yekaterinburg
APP_BASE_URL=http://localhost:3000
# Не короче 32 символов; ключ HMAC для лимитов по IP и подписи ссылок. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=change-me-to-64-hex-chars-change-me-to-64-hex-chars
# Basic auth мини-админки, формат user:password [ф1B]
ADMIN_BASIC_AUTH=
# Обязательны, если не включён DEMO_MODE
DATABASE_URL=postgres://detaly:detaly@postgres:5432/detaly
REDIS_URL=redis://redis:6379/0
# true — демо витрины без Postgres и Redis (Vercel, показ партнёру): поиск по фикстурам,
# корзина в подписанной cookie, оформление и заказы выключены. Требует ROSSKO_MODE=fixtures
# и пустые YOOKASSA_*. Инструкция: docs/demo-vercel.md
DEMO_MODE=false
# Хэш коммита образа; показывается в /ping и /api/health. Заполняет CI/deploy.
GIT_SHA=dev
# true на stage: X-Robots-Tag: noindex на всех ответах
NOINDEX_ALL=false
# x-real-ip — доверять заголовку X-Real-IP от Caddy (web не опубликован наружу); none — IP не определяется (local)
TRUSTED_IP_HEADER=none
# /api/health отвечает 503, если heartbeat worker'а старше стольких секунд
HEARTBEAT_STALE_SEC=300

# --- Хранилище и бэкап [ф0] ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_KEY=
S3_SECRET=
# Запасной режим шифрования бэкапа (gpg --symmetric), если не задан BACKUP_AGE_RECIPIENT
BACKUP_PASSPHRASE=
# Публичный ключ age (age1...); приватный ключ хранится у владельца офлайн
BACKUP_AGE_RECIPIENT=

# --- Фото: заявки VIN, претензии, упаковка [ф1C] ---
# none — фото выключены (поле фото в формах скрыто), local — каталог FILES_LOCAL_DIR
# (разработка, e2e), s3 — бакет в S3 РФ (нужны S3_ENDPOINT, S3_KEY, S3_SECRET и бакет).
# По умолчанию none; при DEMO_MODE=true — только none
FILES_STORAGE=
# Каталог фото при FILES_STORAGE=local, по умолчанию var/files
FILES_LOCAL_DIR=
# Бакет фото, по умолчанию S3_BUCKET (бэкапы лежат там же под BACKUP_PREFIX)
FILES_S3_BUCKET=
# Префикс ключей фото в бакете, по умолчанию files/
FILES_S3_PREFIX=
# Предел одного фото в мегабайтах (1–12), по умолчанию 8
FILES_MAX_UPLOAD_MB=

# --- Контейнер backup [infra] (infra/backup, docs/runbook.md) ---
# s3 — rclone в S3_BUCKET; local — каталог BACKUP_LOCAL_DIR (локальная проверка). По умолчанию s3
BACKUP_STORAGE=
# Префикс объектов в бакете, по умолчанию postgres
BACKUP_PREFIX=
# Срок хранения дампов в днях, по умолчанию 30
BACKUP_RETENTION_DAYS=
# Каталог дампов при BACKUP_STORAGE=local, по умолчанию /backups
BACKUP_LOCAL_DIR=
# 1 — снять дамп при старте контейнера backup, по умолчанию 0
BACKUP_ON_START=
# Повтор алерта healthwatch.sh, пока проблема не ушла (минуты), по умолчанию 60
HEALTHWATCH_REPEAT_MIN=

# --- Контейнер postgres [infra]; DATABASE_URL для контейнеров compose собирает из этих значений ---
# По умолчанию detaly
POSTGRES_USER=
# Обязателен в проде, deploy.sh отклоняет пустой и «detaly». Только URL-безопасные символы: openssl rand -hex 24
POSTGRES_PASSWORD=
# По умолчанию detaly
POSTGRES_DB=

# --- Деплой [infra] ---
# Реестр образов, по умолчанию ghcr.io/wakeupitsadream
IMAGE_REGISTRY=
IMAGE_TAG=latest
# Тег образов stage, по умолчанию IMAGE_TAG; deploy.sh stage задаёт его сам
STAGE_IMAGE_TAG=
SITE_DOMAIN=
STAGE_DOMAIN=
ACME_EMAIL=
# basic_auth Caddy для stage; хэш: caddy hash-password
STAGE_BASIC_AUTH_USER=
STAGE_BASIC_AUTH_HASH=

# --- Бренд, реквизиты продавца, точка выдачи [ф0] ---
# Рабочее название; в коде нет хардкода бренда и реквизитов.
BRAND_NAME=Детали
# ФИО предпринимателя без «ИП» (сайт и документы добавляют его сами): Иванов Иван Иванович
SELLER_REQUISITES_NAME=
# ИНН ИП — 12 цифр
SELLER_REQUISITES_INN=
# ОГРНИП — 15 цифр
SELLER_REQUISITES_OGRNIP=
SELLER_REQUISITES_ADDRESS=
SELLER_REQUISITES_EMAIL=
SELLER_REQUISITES_PHONE=
PICKUP_POINT_NAME=
PICKUP_ADDRESS=
PICKUP_HOURS=
PICKUP_PHONE=
# Маршрут до точки выдачи (https-ссылки «Маршрут в Яндекс Картах» и «2ГИС»), необязательно
PICKUP_MAP_URL_YANDEX=
PICKUP_MAP_URL_2GIS=
# Чат точки для заявки по VIN с фото СТС, например https://t.me/имя_чата; необязательно
PICKUP_TELEGRAM_URL=
# Логотип точки выдачи — путь к файлу в apps/web/public, необязательно (без него — иконка пина):
# цветной знак для белых карточек и белая эмблема для красной шапки, например
# /images/partner/servis56-logo-color.webp и /images/partner/servis56-emblem-white.webp
PICKUP_LOGO_SRC=
PICKUP_EMBLEM_WHITE_SRC=
# Сотрудники для сида (upsert по tgUserId), JSON-массив:
# [{"name":"Максим","role":"owner","tgUserId":111},{"name":"Лёша","role":"seller","tgUserId":222}]
STAFF_SEED_JSON=[]

# --- Партнёр по установке [ф1C] ---
# Сервис, который ставит детали и сам берёт оплату по своему чеку, например «Сервис56».
# Пусто — запись на установку не показывается
INSTALL_PARTNER_NAME=
# Реквизиты партнёра для текста «установка оплачивается в сервисе по его чеку»: ИП …, ИНН …
INSTALL_PARTNER_REQUISITES=

# --- Rossko SOAP v2.1 [ф0] ---
# fixtures — синтетические фикстуры и плашка «демо-данные»; live — реальный API (нужны KEY1/KEY2)
ROSSKO_MODE=fixtures
ROSSKO_KEY1=
ROSSKO_KEY2=
ROSSKO_WSDL_BASE=https://api.rossko.ru/service/v2.1
ROSSKO_DELIVERY_ID=
ROSSKO_ADDRESS_ID=
ROSSKO_PAYMENT_ID=
# id складов Оренбурга через запятую (оплата при получении)
ROSSKO_LOCAL_STOCK_IDS=
ROSSKO_RPM_LIMIT=250
ROSSKO_DAILY_LIMIT=90000
# При этом проценте суточной квоты поиск отвечает только из кэша
ROSSKO_QUOTA_BREAKER_PCT=70
# false на stage и в разработке: GetCheckout запрещён
ROSSKO_ALLOW_CHECKOUT=false
ROSSKO_TIMEOUT_MS=15000

# --- Цены и сроки: значения по умолчанию для settings, правки из админки важнее [ф0/ф1] ---
PRICING_MARKUP_PCT=28
PRICE_DRIFT_TOLERANCE_PCT=3
MARGIN_FLOOR_PCT=10
# Рубли; 0 = без порога (уточнить)
MIN_ORDER_TOTAL=0
MIN_MARGIN_RUB=0
ETA_BUFFER_DAYS=1
ORDER_PAYMENT_TTL_MIN=120
# Рубли: оплата при получении только при сумме не больше этой и неявках меньше NO_SHOW_LIMIT
ON_PICKUP_MAX_TOTAL=15000
ON_PICKUP_CONFIRM_TTL_H=24
PICKUP_WINDOW_PREPAID_DAYS=10
PICKUP_WINDOW_COD_DAYS=7
SUPPLIER_RETURN_DAYS=14
SUPPLIER_INVOICE_LAG_DAYS=1
HANDED_COMPLETE_DAYS=7
HANDOVER_QR_TTL_MIN=15
NO_SHOW_LIMIT=2
REMINDER_DAYS=3,6,9
# Рубли; курьер — фаза 2
COURIER_FEE_RUB=0
# Срок жизни cookie корзины в днях [ф1A]
CART_TTL_DAYS=30

# --- ЮKassa [ф0 спайк / ф1B] ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
# Код системы налогообложения: 2 = УСН доходы (VERIFY Ю4: сверить с документацией ЮKassa).
# Оплата на сайте включается, только когда заданы SHOP_ID, SECRET_KEY, TAX_SYSTEM_CODE и VAT_CODE.
YOOKASSA_TAX_SYSTEM_CODE=
# Код ставки НДС: 1 = без НДС (VERIFY Ю4: сверить с документацией ЮKassa)
YOOKASSA_VAT_CODE=
# IP/CIDR уведомлений ЮKassa через запятую; пустой список = все вебхуки отклоняются (403).
# Опубликованные ЮKassa подсети (VERIFY Ю5: сверить актуальный список в документации):
# 185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11,77.75.156.35,77.75.154.128/25,2a02:5180::/32
YOOKASSA_WEBHOOK_IP_ALLOWLIST=
YOOKASSA_RETURN_URL=

# --- Боты и SMS [ф0 бот продавца / ф1C / ф2] ---
TG_SELLER_BOT_TOKEN=
# id закрытого чата продавцов (отрицательное число)
TG_SELLER_CHAT_ID=
# Клиентский бот статусов [ф1C]: токен из @BotFather (отдельный бот, не продавца); без него клиентам — SMS по allowlist
TG_CLIENT_BOT_TOKEN=
# username клиентского бота без @ для ссылки t.me/<username>?start=…; без него кнопка «Статусы в Telegram» неактивна
TG_CLIENT_BOT_USERNAME=
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=
# none | smsaero | smsc
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER=
SMS_MONTHLY_BUDGET_RUB=
# Логин SMS-шлюза [ф1B]: e-mail аккаунта SMS Aero или логин smsc.ru; пароль/ключ — SMS_API_KEY
SMS_LOGIN=
# Адрес шлюза [ф1B], пусто = по SMS_PROVIDER: https://gate.smsaero.ru/v2 или https://smsc.ru/sys
# (VERIFY: адреса и форматы API сверить с провайдером)
SMS_API_URL=
# Цена одного SMS в копейках для месячного бюджета [ф1B] (VERIFY: тариф провайдера)
SMS_PRICE_KOP=500
# Yandex SmartCaptcha [ф2]
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# --- VIN [ф1C ручной / ф3 каталог] ---
# manual | laximo | acat | partsapi
VIN_PROVIDER=manual
LAXIMO_LOGIN=
LAXIMO_KEY=
ACAT_TOKEN=
PARTSAPI_KEY=
VIN_MONTHLY_BUDGET_RUB=

# --- Юридическое [ф0] ---
# Опубликованные версии из content/legal/<kind>/<version>.md; пусто — показывается черновик с плашкой
LEGAL_OFFER_VERSION=
LEGAL_PRIVACY_VERSION=
LEGAL_CONSENT_PD_VERSION=
LEGAL_CONSENT_MARKETING_VERSION=
LEGAL_RETURN_MEMO_VERSION=
# Номер записи в реестре операторов ПД; формы сбора ПД включаются только после него
RKN_NOTICE_NUMBER=
