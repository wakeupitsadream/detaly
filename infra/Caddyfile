# Caddy is the only service with published ports (80, 443). It terminates TLS
# (Let's Encrypt) and proxies to web:3000, which is not reachable from outside.
#
# Environment (passed by infra/docker-compose.yml):
#   SITE_DOMAIN            production domain (default "localhost": local TLS, no ACME)
#   STAGE_DOMAIN           stage domain (default "stage.localhost")
#   ACME_EMAIL             Let's Encrypt account email (required in production)
#   STAGE_BASIC_AUTH_USER  basic_auth user for stage
#   STAGE_BASIC_AUTH_HASH  bcrypt hash from `caddy hash-password` (see docs/runbook.md)
#
# There is intentionally no rate_limit here: the stock caddy image has no such module.
# Search/SMS limits live in the application (apps/web/src/proxy.ts, Redis sliding window).
# Trust in X-Real-IP comes from the network layout: Caddy always overwrites it with the
# TCP peer address, and web is not published, so clients cannot reach it directly.
{
	email {$ACME_EMAIL:admin@localhost}

	servers {
		# Caddy is the edge: no proxy sits in front of it, so it must NOT trust
		# X-Forwarded-For from clients. Enable only if a CDN/LB is put in front:
		# trusted_proxies static private_ranges
	}

	# Every other log (http.log.error with the failed request, TLS, ...): the same filter as
	# the access log in (common), so a 502 does not log the full IP, User-Agent, token or a
	# redirect target.
	log default {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>headers>User-Agent delete
				request>headers>Referer delete
				request>headers>X-Real-Ip delete
				request>headers>X-Forwarded-For delete
				resp_headers>Location delete
				request>uri regexp ^/(o|p|api/orders|api/proposals|vin/sent)/[^/?]+ /$1/[redacted]
			}
		}
	}
}

(common) {
	encode zstd gzip

	# Request bodies of the API: the largest are photo forms (3 photos, phase 1C decision С19),
	# which the app also limits per file; anything bigger never reaches Next.
	@api path /api/*
	request_body @api {
		max_size 12MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Access log without personal data in clear form (152-FZ, privacy policy section 3):
	# client IPs are truncated to the subnet (/24, /48), browser and forwarding headers are
	# dropped, and secret tokens in the path are redacted: orders /o/<token> and
	# /api/orders/<token>/..., VIN proposals /p/<token> and /api/proposals/<token>/take, VIN
	# confirmations /vin/sent/<link token> (phase 1C). The Location response header is dropped
	# too: redirects carry t.me/<bot>?start=<link token> and /p/<token>. Caddy already omits
	# Cookie and Authorization; apps/web/test/caddyfile.test.ts checks the filter. Retention is
	# the docker json-file rotation (10m x 3 per service, infra/docker-compose.yml).
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>headers>User-Agent delete
				request>headers>Referer delete
				request>headers>X-Real-Ip delete
				request>headers>X-Forwarded-For delete
				resp_headers>Location delete
				request>uri regexp ^/(o|p|api/orders|api/proposals|vin/sent)/[^/?]+ /$1/[redacted]
			}
		}
	}
}

{$SITE_DOMAIN:localhost} {
	import common

	# Health endpoints are for the container healthcheck and deploy.sh (both inside the
	# Docker network): from the internet they would leak GIT_SHA and cost a DB/Redis query
	# per call without any limit.
	@health path /api/health /api/health/*
	respond @health 404

	reverse_proxy web:3000 {
		# The client IP as seen by Caddy (TCP peer). The app trusts only this header
		# (TRUSTED_IP_HEADER=x-real-ip); any client-supplied X-Real-IP is replaced.
		header_up X-Real-IP {remote_host}
	}
}

{$STAGE_DOMAIN:stage.localhost} {
	import common

	header X-Robots-Tag "noindex, nofollow"

	# Payment/messenger webhooks cannot do basic auth; they are verified by the app
	# (YooKassa IP allowlist + re-reading the object via API, MAX secret header).
	@protected not path /api/webhooks/*
	basic_auth @protected {
		{$STAGE_BASIC_AUTH_USER:stage} {$STAGE_BASIC_AUTH_HASH:disabled}
	}

	# web-stage exists only with `--profile stage`; otherwise Caddy answers 502.
	reverse_proxy web-stage:3000 {
		header_up X-Real-IP {remote_host}
	}
}
