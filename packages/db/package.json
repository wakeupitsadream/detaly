{
  "name": "@detaly/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:drift": "drizzle-kit generate && git diff --exit-code -- drizzle",
    "db:migrate": "node --import tsx src/migrate.ts",
    "db:seed": "node --import tsx src/seed-cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@detaly/config": "workspace:*",
    "@detaly/domain": "workspace:*",
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9",
    "tsx": "4.23.15",
    "uuid": "14.0.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
